PORT=4000

# ============ POSTGRESQL ============
# Créez d'abord la base :  createdb vianova   (ou  CREATE DATABASE vianova;)
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/vianova
# Ou, si le mot de passe contient des caractères spéciaux, utilisez plutôt ces lignes :
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=VOTRE_MOT_DE_PASSE
# DB_NAME=vianova
DB_SSL=false
DB_POOL_MAX=10

JWT_SECRET=changez-moi-par-une-longue-valeur-aleatoire
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@vianona.mg
ADMIN_PASSWORD=changez-moi

# ============ E-MAIL : confirmation d'admission à un cours ============
# Sans ces valeurs, l'e-mail est seulement affiché dans la console du serveur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vianova Academy <admin@vianona.mg>
